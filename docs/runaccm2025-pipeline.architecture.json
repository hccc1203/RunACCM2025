  "cards": [
    {
      "dot": "cyan",
      "title": "三线程流水线",
      "items": [
        "producer 取一帧后同帧投递巡线与 AI 两条 Factory 队列",
        "AIConsumer 用 PPNC NNA 跑主干、ONNX 跑 NMS，写共享 predict_result",
        "consumer 调 Standard::run 得 PWM 与速度，经 Uart 下发",
        "队列满即丢最旧帧（pop_front），保时延不保帧序"
      ]
    },
    {
      "dot": "emerald",
      "title": "巡线与中线生成",
      "items": [
        "OTSU 二值化 → floodFill 只留车道连通域 → 最长白列定起点",
        "迷宫法爬边线 → 逆透视 → 滤波 → 等距重采样 → 角度 + 非极大值抑制找拐点",
        "单边中线按法向外推半车道宽；双边取四点做三阶贝塞尔",
        "trackState 默认取点数更多的一侧"
      ]
    },
    {
      "dot": "violet",
      "title": "场景状态机",
      "items": [
        "仅 NormalScene 做元素检测，且受 elem_order[order_index] 放行",
        "元素状态清回 NONE 后 scene 复位且 order_index++",
        "元素模块就地改写 t_pointsEdge 或 AI_CenterEdge"
      ]
    },
    {
      "dot": "amber",
      "title": "控制量计算与下发",
      "items": [
        "按 aim_distance_near / far 各取一预瞄点算 error_near / error_far",
        "aim_angle 按场景加权；常规路段只用 error_near",
        "PD 输出 ×30 从 PWMSERVOMID 3840 反叠，夹紧 3000~4700",
        "中线无效沿用上一帧；CROSSWALK_STOP 置 Stop_flag 停车"
      ]
    }
  ]
